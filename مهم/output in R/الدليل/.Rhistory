library(sf)
library(ggplot2)
library(dplyr)
# 1. تحميل ملف الخريطة (Shapefile)
# ملاحظة: يجب أن يكون لديك ملف باسم 'najaf_districts.shp' أو ما يشابهه
# يمكنك تحميل حدود العراق الإدارية من موقع GADM أو Humanitarian Data Exchange
# najaf_map <- st_read("path/to/your/najaf_districts.shp")
# 2. مثال توضيحي باستخدام كود الرسم بعد تحميل البيانات
# سنفترض أن المتغير 'najaf_map' يحتوي على حدود الوحدات الإدارية
ggplot(data = najaf_map) +
geom_sf(aes(fill = admin_name), color = "white", size = 0.2) + # تلوين حسب اسم الوحدة الإدارية
scale_fill_viridis_d(option = "plasma", name = "الوحدة الإدارية") + # تدرج لوني احترافي
theme_minimal() +
labs(
title = "خريطة محافظة النجف الأشرف الإدارية",
subtitle = "مقسمة حسب الوحدات الإدارية",
caption = "المصدر: قسم التخطيط التربوي - شعبة الإحصاء"
) +
theme(
text = element_text(family = "Arial"), # لضمان ظهور الخط العربي بشكل صحيح
plot.title = element_text(hjust = 0.5, face = "bold"),
legend.position = "right",
panel.grid = element_blank()
) +
coord_sf(datum = NA) # إخفاء خطوط الطول والعرض لجمالية الخريطة
# 1. تحميل الحزم المطلوبة
library(sf)
library(ggplot2)
library(dplyr)
library(geodata) # حزمة لجلب الخرائط برمجياً
install.packages("geodata")
# 1. تحميل الحزم المطلوبة
library(sf)
library(ggplot2)
library(dplyr)
library(geodata) # حزمة لجلب الخرائط برمجياً
# 2. تحميل حدود العراق الإدارية (المستوى الثاني: الأقضية)
# سيقوم البرنامج بتحميل الملف وتخزينه في مجلد المشروع
iraq_districts <- gadm(country = "IRQ", level = 2, path = tempdir(), version = "latest")
# 3. تحويل البيانات إلى صيغة sf للتعامل معها بسهولة
iraq_sf <- st_as_sf(iraq_districts)
# 4. تصفية البيانات لاستخراج محافظة النجف فقط
# ملاحظة: الاسم في قاعدة البيانات العالمية يكتب عادة "An-Najaf"
najaf_map <- iraq_sf %>%
filter(NAME_1 == "An-Najaf")
# 5. رسم الخريطة
ggplot(data = najaf_map) +
geom_sf(aes(fill = NAME_2), color = "black", size = 0.3) +
scale_fill_brewer(palette = "Set3", name = "القضاء") +
theme_minimal() +
labs(
title = "خريطة الوحدات الإدارية لمحافظة النجف الأشرف",
caption = "بيانات مستخرجة من قاعدة بيانات GADM"
) +
theme(
text = element_text(family = "Arial"),
plot.title = element_text(hjust = 0.5)
)
install.packages("nomnoml")
# رسم الخريطة
nomnoml(mind_map_code)
# تثبيت الحزمة إذا لم تكن متوفرة
# install.packages("nomnoml")
library(nomnoml)
# نفترض أن هذه الأرقام قادمة من متغيراتك أو من ملف YAML
count_schools <- 450  # مثال لعدد المدارس
count_students <- 125000 # مثال لعدد الطلاب
# بناء نص الخريطة برمجياً لدمج الأرقام
mind_map_code <- paste0("
#direction: down
[<abstract> النجف الأشرف] -> [الواقع التربوي]
[الواقع التربوي] -> [المدارس: ", count_schools, "]
[الواقع التربوي] -> [الطلاب: ", count_students, "]
[المدارس: ", count_schools, "] -> [ابتدائي]
[المدارس: ", count_schools, "] -> [ثانوي]
")
# رسم الخريطة
nomnoml(mind_map_code)
